# Domain mode: automatic HTTPS. Use ASCII/punycode for an internationalized domain.
DOMAIN=artifacts.example.com
SITE_ADDRESS=artifacts.example.com

# IP-only mode: replace both values and use plain HTTP.
# DOMAIN=203.0.113.10
# SITE_ADDRESS=http://203.0.113.10

# Two workers are a reasonable default for a 2 vCPU / 4 GB VPS.
WEB_CONCURRENCY=2

ARTCALC_TIME_LIMIT=0.5
ARTCALC_SOLUTIONS_PER_CONTAINER=1
ARTCALC_CP_WORKERS=1
ARTCALC_NONLINEAR_ITERATIONS=3
ARTCALC_UPGRADE_TIME_LIMIT=0.25
ARTCALC_UPGRADE_NONLINEAR_ITERATIONS=2
